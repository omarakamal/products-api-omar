<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products Lab API</title>
    <link rel="stylesheet" href="./style.css">
    <style>
        .App {
    font-family: sans-serif;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #ffffff;
  }
   



  table,tr, th, td {
    border: 2px solid black;
    padding: 10px;
  }
  
    </style>
</head>
<body>
    
    <div class="App">
        <h1>BONUS: Update and Delete</h1>
        <br>
        <br>
        <!-- <h2> <a href="/products">Link to All Products</a></h2> -->
        <br>
        <p><b>Base Url: </b>https://products-api-164h.onrender.com/</p>

        <h2>Endpoints:</h2>
        <table>
            <tr>
                <th>Endpoints</th>
                <th>HTTP Method</th>
                <th>Response Data Type</th>
                <th>Description</th>
            </tr>
            <tr>
                <td>/products/:id</td>
                <td>PUT</td>
                <td>{}</td>
                <td>Updates the product</td>
            </tr>
            <tr>
                <td>/products/:id</td>
                <td>DELETE</td>
                <td>"Product deleted"</td>
                <td>Deletes one Product by its id</td>
            </tr>
        
        </table>
    </div>
